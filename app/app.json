{
  "expo": {
    "name": "بصيرة",
    "slug": "basira-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.basira.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "هذا التطبيق يحتاج إلى إذن الميكروفون لتسجيل صوتك وتحويله إلى نص.",
        "NSSpeechRecognitionUsageDescription": "هذا التطبيق يحتاج إلى إذن التعرف على الكلام لتحليل أفكارك الصوتية."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F5"
      },
      "package": "com.basira.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}